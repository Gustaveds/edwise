# ─────────────────────────────────────────────────────────
# EdWise — variáveis de ambiente (DEV LOCAL)
# Copie este arquivo para `.env` e ajuste o que precisar.
# Tanto o backend quanto o docker-compose.dev.yml leem este arquivo.
# ─────────────────────────────────────────────────────────

# Banco de dados (Postgres rodando via docker-compose.dev.yml)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=edwise
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL é só informativo (alguns scripts antigos imprimem ele); pode manter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edwise

# Servidor backend
PORT=3001
NODE_ENV=development
JWT_SECRET=dev-secret-change-me

# Frontend (Vite) — apontando pro backend local
VITE_API_URL=http://localhost:3001

# Gemini AI (opcional em dev — recursos de IA não funcionam sem isto)
GEMINI_API_KEY=

# MinIO / S3 (subido via docker-compose.dev.yml)
# Console web: http://localhost:9001 (login: minioadmin / minioadmin)
MINIO_SERVER_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=edwise

# Redis (opcional em dev — fila de jobs do worker)
REDIS_HOST=localhost
REDIS_PORT=6379
